# Zylos environment configuration
# Copy to `.env.local` for local development, or set these in your hosting
# platform (Vercel / Netlify / Cloudflare Pages) for production.

# Public site origin — used for canonical URLs, the sitemap, Open Graph
# tags and JSON-LD absolute URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://zylos.example.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When set, GA4 and Core Web Vitals reporting load with anonymized IPs and
# the Content-Security-Policy automatically allows the Google Analytics
# origins. Leave blank to disable all analytics — nothing loads and no data
# leaves the browser.
NEXT_PUBLIC_ANALYTICS_ID=

# Optional external image host (CDN / object store) holding real photographs.
# When set, it is allow-listed for next/image optimization and added to the
# CSP img-src. Leave blank to serve all imagery same-origin from /public.
# Example: cdn.zylos.example.com
NEXT_PUBLIC_IMAGE_HOST=

# Image generation (used by `node scripts/generate-images.mjs` only — never
# shipped to the client). OpenAI Images-compatible by default.
IMAGE_API_KEY=
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-1
