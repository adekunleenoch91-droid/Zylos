# Zylos environment configuration
# Copy to `.env.local` for local development, or set these in your hosting
# platform (Vercel / Netlify / Cloudflare Pages) for production.

# Public site origin — used for canonical URLs, the sitemap, Open Graph
# tags and JSON-LD absolute URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://zylos.example.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When set, GA4 and Core Web Vitals reporting load with anonymized IPs and
# the Content-Security-Policy automatically allows the Google Analytics
# origins. Leave blank to disable all analytics — nothing loads and no data
# leaves the browser.
NEXT_PUBLIC_ANALYTICS_ID=
